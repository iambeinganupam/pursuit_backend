PROJECT_NAME="Social Habit Tracker"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace_me_with_a_secure_random_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Neon Serverless Postgres Example (asyncpg requires postgresql+asyncpg driver)
# Format: postgresql+asyncpg://[user]:[password]@[host]/[dbname]?ssl=require
DATABASE_URL="postgresql+asyncpg://user:password@ep-example-host.neon.tech/neondb?ssl=require"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:8081", "exp://localhost:8081"]
